# ─────────────────────────────────────────────────────────────
#  Configuration de YT Veille
#  Copie ce fichier en « .env » puis remplis la clé API.
# ─────────────────────────────────────────────────────────────

# Clé YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=ta_cle_api_ici

# Base de données.
#   En local (simplissime) : SQLite
DATABASE_URL=sqlite:///./yt_veille.db
#   En ligne (Neon) : décommente et remplace par ta chaîne de connexion
#   (nécessite le paquet « psycopg » : pip install "psycopg[binary]")
# DATABASE_URL=postgresql+psycopg://user:motdepasse@host.neon.tech/neondb?sslmode=require

# Fenêtre de fraîcheur des vidéos (en jours)
FRESHNESS_DAYS=7

# Nombre de résultats demandés à YouTube par mot-clé (1–50)
MAX_RESULTS_PER_KEYWORD=25

# Tri de recherche YouTube : relevance | viewCount | date | rating
SEARCH_ORDER=relevance

# Paramètre de décroissance de la fraîcheur (jours) : plus petit = plus sévère
RECENCY_TAU_DAYS=7
